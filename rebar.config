{erl_opts, [no_debug_info]}.
{deps, [
    {erlangchain, {git, "https://github.com/kasicass/erlangchain.git", {branch, "main"}}}
]}.

{escript_incl_apps, [tinyagent, erlangchain]}.
{escript_main_app, tinyagent}.
{escript_name, tinyagent}.
{escript_emu_args, "%%! +sbtu +A1\n"}.

{profiles, [
    {test, [
        {erl_opts, [debug_info]}
    ]}
]}.
